---
// Demonstrates proper SCSS architecture:
// - No <style> tags in this file
// - All styles imported from external SCSS files
// - Global styles applied via import in the head

import { siteConfig } from '@/lib/config';

import '@/styles/globals.scss';

interface Props {
    pageTitle?: string | string[];
    description?: string;
}

const {
    pageTitle,
    description = siteConfig.appDescription,
} = Astro.props;

const pageArray = Array.isArray(pageTitle) ? pageTitle : [pageTitle];

const firstElement = pageArray?.[0];
const shouldSkipFirst =
    firstElement === '' ||
    firstElement === siteConfig.appName ||
    firstElement?.toLowerCase() === 'index' ||
    firstElement?.toLowerCase() === 'home';

const newPageTitle = (pageArray && pageArray.length > 0 && firstElement)
    ? shouldSkipFirst
        ? pageArray.filter((_, i) => i !== 0)
        : pageArray
    : null;

const title = newPageTitle ? `${newPageTitle.join(' | ')} | ${siteConfig.appName}` : siteConfig.appName;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <!-- Favicons -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;700&family=Source+Sans+3:wght@400;600;700&display=swap" />

        <!-- PWA manifest -->
        <link rel="manifest" href="/manifest.webmanifest" />

        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>
