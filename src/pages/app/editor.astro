---
import { queryItems } from '@/db/helpers';
import { songTable } from '@/db/schemas';
import type { Song } from '@/db/types';

import App from '@/layouts/App.astro';
import EditorScript from '@/script/app/editor.astro';
import '@/styles/components/button.scss';
import '@/styles/components/form.scss';
import '@/styles/pages/editor.scss';

if (!Astro.locals.session || !Astro.locals.user) return Astro.redirect('/user/sign-in');

const songs: Song[] = await queryItems(songTable, { KeyConditionExpression: 'userId = :userId', ExpressionAttributeValues: { ':userId': Astro.locals.user.id } });
const song = songs.find(candidate => candidate.id === Astro.url.searchParams.get('song')) ?? songs[0];
const section = song?.sections.find(candidate => candidate.id === Astro.url.searchParams.get('section')) ?? song?.sections[0];
---
<App pageTitle="Write notes">
    <div class="editor">
        <h1 class="editor__title">Write notes</h1>

        {song && section ? (
            <>
                <p class="editor__meta">{song.title} &middot; {section.name} &middot; Key of {song.key} &middot; {song.tempo} BPM</p>
                <script type="application/json" id="editor-data" data-song={song.id} data-key={song.key} is:inline set:html={JSON.stringify(section).replaceAll('<', '\\u003c')}></script>

                <section class="bar editor__bar" aria-labelledby="bar-heading">
                    <span class="sign">Bar</span>
                    <h2 id="bar-heading" class="editor__heading">Choose a bar</h2>
                    <div class="editor__bars" role="group" aria-label="Bars">
                        {Array.from({ length: section.bars }, (_, index) => index + 1).map(bar =><button class="chord" type="button" data-bar={bar} aria-label={`Bar ${bar}`} aria-pressed={bar === 1 ? 'true' : 'false'}>{bar}</button>)}
                    </div>
                    <ul class="editor__chords" id="chord-readout" aria-live="polite"></ul>
                </section>

                <section class="editor__views" aria-label="Notes in this bar">
                    <div class="staff-block editor__view">
                        <h2 class="editor__heading" id="tab-heading">Tab</h2>
                        <svg id="tab" class="editor__svg" role="img" aria-labelledby="tab-heading" aria-describedby="tab-description" viewBox="0 0 640 120"></svg>
                        <p class="indicative-note" id="tab-description"></p>
                    </div>
                    <div class="staff-block editor__view">
                        <h2 class="editor__heading" id="sheet-heading">Sheet music</h2>
                        <svg id="sheet" class="editor__svg" role="img" aria-labelledby="sheet-heading" aria-describedby="sheet-description" viewBox="0 0 640 170"></svg>
                        <p class="indicative-note" id="sheet-description"></p>
                    </div>
                </section>

                <section class="bar editor__bar" aria-labelledby="entry-heading">
                    <span class="sign">Note</span>
                    <h2 id="entry-heading" class="editor__heading"><span id="entry-verb">Add a note</span> in bar <span id="entry-bar">1</span></h2>
                    <form class="form editor__form" id="note-form" novalidate>
                        <div class="form-group">
                            <label class="form-label" for="note-beat">Beat</label>
                            <input class="form-input" id="note-beat" name="beat" type="number" min="1" max="4.75" step="0.25" value="1" aria-describedby="editor-error" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="note-duration">Length</label>
                            <select class="form-select" id="note-duration" name="duration">
                                <option value="4">Whole</option>
                                <option value="2">Half</option>
                                <option value="1" selected>Quarter</option>
                                <option value="0.5">Eighth</option>
                                <option value="0.25">Sixteenth</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="note-pitch">Pitch</label>
                            <input class="form-input" id="note-pitch" name="pitch" type="text" inputmode="text" autocomplete="off" placeholder="C#4" aria-describedby="note-help editor-error" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="note-string">String</label>
                            <select class="form-select" id="note-string" name="string" aria-describedby="note-help editor-error">
                                <option value="">None</option>
                                {[1, 2, 3, 4, 5, 6].map(string => <option value={string}>{string}</option>)}
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="note-fret">Fret</label>
                            <input class="form-input" id="note-fret" name="fret" type="number" min="0" max="24" step="1" aria-describedby="note-help editor-error" />
                        </div>
                        <p class="form-helper editor__help" id="note-help">Write a pitch such as C4, F#3 or Bb4, or pick a string and fret. If you give a string and fret, the pitch comes from them. String 1 is the thinnest.</p>
                        <div class="form-actions editor__actions">
                            <button class="btn editor__action" type="submit" data-variant="primary" id="note-submit">Add note</button>
                            <button class="btn editor__action" type="button" data-variant="secondary" id="note-cancel" hidden>Cancel change</button>
                        </div>
                    </form>
                    <p class="editor__error" id="editor-error" role="alert"></p>
                    <p class="editor__status" id="editor-status" role="status"></p>
                </section>

                <section class="bar editor__bar" aria-labelledby="notes-heading">
                    <span class="sign">List</span>
                    <h2 id="notes-heading" class="editor__heading" tabindex="-1">Notes in bar <span id="list-bar">1</span></h2>
                    <ul class="editor__notes" id="note-list"></ul>
                    <p class="indicative-note">Notes outside the scale are marked, never removed. Keep, change or remove any note you like.</p>
                </section>

                <section class="suggestion editor__reason" id="reason" aria-labelledby="reason-heading" hidden>
                    <h2 class="editor__heading" id="reason-heading" tabindex="-1"></h2>
                    <div class="editor__reason-body" id="reason-body" aria-live="polite"></div>
                </section>

                <EditorScript />
            </>
        ) : (
            <p class="note-blocked" role="status">You have no songs yet. Create a song with a section to start writing notes.</p>
        )}
    </div>
</App>
