---
import App from '@/layouts/App.astro';
import EditorScript from '@/script/app/editor.astro';
import '@/styles/pages/app/editor.scss';

if (!Astro.locals.session) return Astro.redirect('/user/sign-in');

const PITCHES = ['C5','B4','A4','G4','F4','E4','D4','C4','B3','A3','G3','F3','E3','D3','C3'];
const BEATS = [1, 2, 3, 4];
---

<App pageTitle="Editor">
    <EditorScript />

    <div class="editor-page">
        <div class="editor-page__head">
            <h1 class="editor-page__title">Write Notes</h1>
            <p class="editor-page__lead">Click a cell to place a note. Copilot marks notes that fit the current chord and scale, and marks any note outside with a symbol. Notes are never removed automatically.</p>
        </div>

        <section class="editor-page__settings" aria-label="Editor settings">
            <div class="editor-page__settings-row">
                <div class="editor-page__field">
                    <label class="editor-page__label" for="editor-key">Key</label>
                    <select class="editor-page__input" id="editor-key">
                        <option value="C major">C major</option>
                        <option value="G major">G major</option>
                        <option value="A minor" selected>A minor</option>
                        <option value="E minor">E minor</option>
                        <option value="D minor">D minor</option>
                    </select>
                </div>
                <div class="editor-page__field">
                    <label class="editor-page__label" for="editor-chord">Current chord</label>
                    <input class="editor-page__input" id="editor-chord" type="text" placeholder="e.g. Am" autocomplete="off" />
                </div>
                <div class="editor-page__field">
                    <label class="editor-page__label" for="editor-bars">Bars</label>
                    <input class="editor-page__input" id="editor-bars" type="number" min="1" max="16" value="4" />
                </div>
            </div>
        </section>

        <section class="editor-page__grid-section" aria-label="Note grid">
            <div class="editor-page__legend" aria-hidden="true">
                <span class="note-in">✓ in scale</span>
                <span class="note-out">! outside scale</span>
                <span class="editor-page__legend-chord">● chord tone</span>
            </div>
            <div class="editor-page__grid-wrap" role="grid" aria-label="Tab editor — click to toggle notes" id="note-grid">
            </div>
        </section>

        <section class="editor-page__note-panel" id="note-panel" aria-live="polite" hidden>
            <h2 class="editor-page__panel-title">Note</h2>
            <div class="editor-page__note-detail" id="note-detail"></div>
        </section>

        <div class="editor-page__actions">
            <button class="btn" id="editor-save-btn" type="button">Save notes</button>
            <button class="btn editor-page__clear-btn" id="editor-clear-btn" type="button">Clear all</button>
            <span class="editor-page__save-status indicative-note" id="editor-save-status" aria-live="polite"></span>
        </div>
    </div>
</App>
