---
import siteConfig from '@/lib/config';

import audiences from '@/content/audiences.json';
import engineDoes from '@/content/engine-does.json';
import modelDoes from '@/content/model-does.json';
import modelNever from '@/content/model-never.json';
import pilots from '@/content/pilots.json';
import privacy from '@/content/privacy.json';
import problems from '@/content/problems.json';
import rules from '@/content/rules.json';
import steps from '@/content/steps.json';

import Header from '@/components/Header.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/components/button.scss';
import '@/styles/pages/index.scss';

const year = new Date().getFullYear();
---
<Layout pageTitle="Home">
    <Header />

    <main id="main" class="home">
        <section class="home__hero" aria-labelledby="hero-title">
            <div class="container">
                <div class="home__hero-copy">
                    <p class="home__kicker">Songwriting, with the theory beside you</p>
                    <h1 id="hero-title" class="home__hero-title">
                        Write your song.
                        <span class="home__hero-title-accent">Understand every note.</span>
                    </h1>
                    <p class="home__hero-lead">
                        {siteConfig.appName} explains music theory while you write. Build a chord
                        progression and see the scales, arpeggios and guide tones that fit each chord,
                        with the reason shown beside every suggestion.
                    </p>
                    <p class="home__hero-rule">
                        <strong>{siteConfig.appName} explains and suggests. You decide.</strong>
                    </p>
                    <div class="home__hero-actions">
                        <a class="btn" data-variant="primary" href="#how">How it works</a>
                        <a class="btn" data-variant="secondary" href={siteConfig.docsUrl}>Read the spec</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="home__section" aria-labelledby="problem-title">
            <div class="container">
                <p class="home__kicker">The problem</p>
                <h2 id="problem-title" class="home__section-title">Writing music is hard. Applying theory is harder.</h2>
                <p class="home__section-lead">
                    Most players learn harmony slowly, through trial and copying what they hear.
                    Three things get in the way.
                </p>
                <div class="home__grid" data-columns="3">
                    {problems.map(item => (
                        <article class="home__bar">
                            <span class="home__sign">{item.sign}</span>
                            <h3 class="home__bar-title">{item.title}</h3>
                            <p class="home__bar-body">{item.body}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section id="how" class="home__section" data-variant="card" aria-labelledby="how-title">
            <div class="container">
                <p class="home__kicker">How it works</p>
                <h2 id="how-title" class="home__section-title">Theory at the moment you need it</h2>
                <p class="home__section-lead">
                    {siteConfig.appName} keeps the scale, the chord function and the guide tones next to the notes
                    you are writing, so you see why a note fits instead of just accepting it.
                </p>
                <ol class="home__measures">
                    {steps.map(step => (
                        <li class="home__measure">
                            <span class="home__measure-bar">{step.bar}</span>
                            <h3 class="home__measure-title">{step.title}</h3>
                            <p class="home__measure-body">{step.body}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section id="rules" class="home__section" aria-labelledby="rules-title">
            <div class="container">
                <p class="home__kicker">The rules</p>
                <h2 id="rules-title" class="home__section-title">{siteConfig.appName} explains. The songwriter decides.</h2>
                <p class="home__section-lead">
                    Every suggestion follows five rules. They keep you in charge of the song and
                    make sure you learn the theory, not just the answer.
                </p>
                <dl class="home__rules">
                    {rules.map(rule => (
                        <div class="home__rule-item">
                            <dt class="home__rule-name"><span class="home__sign" data-placement="inline">{rule.name}</span></dt>
                            <dd class="home__rule-body">{rule.body}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <section id="engine" class="home__section" data-variant="card" aria-labelledby="engine-title">
            <div class="container">
                <p class="home__kicker">Under the hood</p>
                <h2 id="engine-title" class="home__section-title">Rules for the theory. Words for the why.</h2>
                <p class="home__section-lead">
                    The music comes from a rule-based theory engine, tested against known progressions.
                    A language model only writes the explanations, and it works from the engine&rsquo;s output.
                </p>
                <div class="home__grid" data-columns="2">
                    <article class="home__bar">
                        <span class="home__sign">Theory engine</span>
                        <h3 class="home__bar-title">Fixed rules, every time</h3>
                        <ul class="home__checks">
                            {engineDoes.map(item => <li>{item}</li>)}
                        </ul>
                    </article>
                    <article class="home__bar">
                        <span class="home__sign">Language model</span>
                        <h3 class="home__bar-title">Explanations only</h3>
                        <ul class="home__checks">
                            {modelDoes.map(item => <li>{item}</li>)}
                        </ul>
                    </article>
                </div>
                <div class="home__never">
                    <h3 class="home__never-title">The model is never allowed to</h3>
                    <ul class="home__never-list">
                        {modelNever.map(item => <li>{item}</li>)}
                    </ul>
                </div>

                <div class="home__flow" aria-label="How a suggestion is made">
                    <ol class="home__flow-list">
                        <li>Input</li>
                        <li>Theory engine</li>
                        <li>Suggestions</li>
                        <li>Editor</li>
                        <li>Autofill</li>
                        <li>Explain</li>
                        <li>Store</li>
                    </ol>
                </div>
            </div>
        </section>

        <section class="home__section" aria-labelledby="audience-title">
            <div class="container">
                <p class="home__kicker">Who it&rsquo;s for</p>
                <h2 id="audience-title" class="home__section-title">Made for hobbyists and music students</h2>
                <p class="home__section-lead">
                    The songwriter is the main user, whether writing for fun or learning harmony.
                </p>
                <div class="home__grid" data-columns="2">
                    {audiences.map(item => (
                        <article class="home__bar">
                            <span class="home__sign">{item.sign}</span>
                            <h3 class="home__bar-title">{item.title}</h3>
                            <p class="home__bar-body">{item.body}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="home__section" data-variant="card" aria-labelledby="privacy-title">
            <div class="container">
                <p class="home__kicker">Your music stays yours</p>
                <h2 id="privacy-title" class="home__section-title">Private by default, open to everyone</h2>
                <p class="home__section-lead">
                    Songs, melodies and class data follow clear rules, and every control is built for keyboards and screen readers.
                </p>
                <div class="home__grid" data-columns="4">
                    {privacy.map(item => (
                        <article class="home__tile">
                            <h3 class="home__tile-title">{item.title}</h3>
                            <p class="home__tile-body">{item.body}</p>
                        </article>
                    ))}
                </div>
                <div class="home__access">
                    <h3 class="home__access-title">Built to be accessible</h3>
                    <p class="home__access-body">
                        Every control works with a keyboard and a screen reader, including note entry
                        and scale selection. Diagrams come with text descriptions, and a note&rsquo;s
                        status is always shown with a symbol as well as a colour.
                    </p>
                </div>
            </div>
        </section>

        <section id="pilot" class="home__section" aria-labelledby="pilot-title">
            <div class="container">
                <p class="home__kicker">The pilot</p>
                <h2 id="pilot-title" class="home__section-title">Two ways to play</h2>
                <div class="home__grid" data-columns="2">
                    {pilots.map(item => (
                        <article class="home__bar">
                            <span class="home__sign">{item.sign}</span>
                            <h3 class="home__bar-title">{item.title}</h3>
                            <p class="home__bar-body">{item.body}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="home__closing" aria-labelledby="closing-title">
            <div class="container home__closing-inner">
                <h2 id="closing-title" class="home__closing-title">Learn why a note fits, while you write it.</h2>
                <p class="home__closing-body">
                    {siteConfig.appName} is in development. Read the full spec or follow along on GitHub.
                </p>
                <div class="home__closing-actions">
                    <a class="btn" data-variant="primary" href={siteConfig.docsUrl}>Read the spec</a>
                    <a class="btn" data-variant="secondary" href={siteConfig.githubUrl}>View on GitHub</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="home__footer">
        <div class="container home__footer-inner">
            <p class="home__footer-brand">
                <span aria-hidden="true">&#x1D11E;</span> {siteConfig.appName}
            </p>
            <p class="home__footer-note">
                Suggestions never change your song. Only an accepted action does. &copy; {year}
            </p>
        </div>
    </footer>
</Layout>
