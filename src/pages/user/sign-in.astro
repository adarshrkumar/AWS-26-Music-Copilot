---
import Header from '@/components/Header.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/components/button.scss';
import '@/styles/components/form.scss';
import '@/styles/pages/user/sign-in.scss';
---

<Layout pageTitle="Sign in">
    <Header />

    <main id="main" class="auth">
        <div class="auth__card">
            <h1 class="auth__title">Sign in</h1>
            <p class="auth__error" role="alert"></p>
            <form class="form auth__form">
                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <input class="form-input" id="email" name="email" type="email" autocomplete="email" required />
                </div>
                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-input" id="password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <button class="btn" type="submit" data-variant="primary" data-width="full">Sign in</button>
            </form>
            <p class="auth__switch">No account yet? <a href="/user/sign-up">Sign up</a></p>
        </div>
    </main>
</Layout>

<script>
    import { authClient } from '@/lib/auth/client';

    function field(name: string): string {
        return document.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ?? '';
    }

    document.querySelector('.auth__form')?.addEventListener('submit', async event => {
        event.preventDefault();
        const button = document.querySelector<HTMLButtonElement>('.auth__form button');
        const message = document.querySelector<HTMLElement>('.auth__error');
        button?.setAttribute('data-state', 'loading');

        const { error } = await authClient.signIn.email({ email: field('email'), password: field('password') });

        button?.removeAttribute('data-state');
        if (!error) return window.location.assign('/');
        if (message) message.textContent = error.message ?? 'Sign in failed. Check your email and password.';
    });
</script>
