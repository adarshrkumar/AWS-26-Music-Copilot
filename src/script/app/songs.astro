<script>
    import { nanoid } from 'nanoid';
    import { z } from 'zod';
    import { songInputSchema } from '@/db/validations';
    import { authClient } from '@/lib/auth/client';
    import songsConfig from '@/lib/songs.config';

    const songFormSchema = songInputSchema.pick({ title: true, key: true, tempo: true, melodyShared: true });
    const localSongsSchema = z.array(songInputSchema.extend({ syncedAt: z.string().max(40).nullable() }));

    type LocalSong = z.infer<typeof localSongsSchema>[number];

    function getLocalSongs(): LocalSong[] {
        const raw = localStorage.getItem(songsConfig.storageKey);
        if (!raw) return [];

        try {
            const parsed = localSongsSchema.safeParse(JSON.parse(raw));
            if (parsed.success) return parsed.data.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
        } catch {
            // Fall through to the backup below, the stored text is not valid JSON
        }

        localStorage.setItem(songsConfig.backupKey, raw);
        return [];
    }

    function getLocalSong(id: string): LocalSong | null {
        return getLocalSongs().find(song => song.id === id) ?? null;
    }

    function saveLocalSongs(songs: LocalSong[]): void {
        localStorage.setItem(songsConfig.storageKey, JSON.stringify(songs));
    }

    function createLocalSong(form: z.infer<typeof songFormSchema>): LocalSong {
        const now = new Date().toISOString();
        const song: LocalSong = {
            id: nanoid(),
            ...form,
            sampleProgressionId: null,
            sections: [],
            suggestions: [],
            createdAt: now,
            updatedAt: now,
            syncedAt: null,
        };

        saveLocalSongs([...getLocalSongs(), song]);
        return song;
    }

    function updateLocalSong(id: string, form: z.infer<typeof songFormSchema>): LocalSong | null {
        const songs = getLocalSongs();
        const index = songs.findIndex(song => song.id === id);
        if (index === -1) return null;

        const song: LocalSong = { ...songs[index], ...form, updatedAt: new Date().toISOString() };
        songs[index] = song;
        saveLocalSongs(songs);
        return song;
    }

    function markLocalSongSynced(id: string, syncedAt: string | null): LocalSong | null {
        const songs = getLocalSongs();
        const index = songs.findIndex(song => song.id === id);
        if (index === -1) return null;

        const song: LocalSong = { ...songs[index], syncedAt };
        songs[index] = song;
        saveLocalSongs(songs);
        return song;
    }

    function deleteLocalSong(id: string): void {
        saveLocalSongs(getLocalSongs().filter(song => song.id !== id));
    }

    function hasUnsyncedChanges(song: LocalSong): boolean {
        return song.syncedAt !== null && song.updatedAt > song.syncedAt;
    }

    function downloadSongExport(songs: LocalSong[], includeMelody: boolean): void {
        const songExport = {
            format: 'tonepilot-songs',
            version: 1,
            exportedAt: new Date().toISOString(),
            includesMelody: includeMelody,
            songs: songs.map(song => ({
                title: song.title,
                key: song.key,
                tempo: song.tempo,
                sections: song.sections.map(({ notes, ...section }) => (includeMelody ? { ...section, notes } : section)),
            })),
        };
        const url = URL.createObjectURL(new Blob([JSON.stringify(songExport, null, 4)], { type: 'application/json' }));
        const link = document.createElement('a');

        link.href = url;
        link.download = `tonepilot-songs-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.append(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
    }

    function find<T extends Element>(root: ParentNode, selector: string): T {
        const element = root.querySelector<T>(selector);
        if (!element) throw new Error(`Missing element: ${selector}`);
        return element;
    }

    const root = find<HTMLElement>(document, '.songs');
    const signedIn = root.dataset.signedIn === 'true';
    const list = find<HTMLUListElement>(root, '[data-role="list"]');
    const empty = find<HTMLElement>(root, '[data-role="empty"]');
    const status = find<HTMLElement>(root, '[data-role="status"]');
    const errorMessage = find<HTMLElement>(root, '[data-role="error"]');
    const exportMelody = find<HTMLInputElement>(root, '[data-role="export-melody"]');
    const dialog = find<HTMLDialogElement>(document, '[data-role="dialog"]');
    const form = find<HTMLFormElement>(dialog, '[data-role="song-form"]');
    const formError = find<HTMLElement>(dialog, '[data-role="form-error"]');
    const dialogTitle = find<HTMLElement>(dialog, '[data-role="dialog-title"]');
    const rowTemplate = find<HTMLTemplateElement>(document, '#song-row');

    function say(message: string): void {
        errorMessage.textContent = '';
        status.textContent = message;
    }

    function fail(message: string): void {
        status.textContent = '';
        errorMessage.textContent = message;
    }

    function syncLabel(song: LocalSong): string {
        if (!song.syncedAt) return '\u25CB On this device only';
        if (hasUnsyncedChanges(song)) return '\u25D0 Synced to your account, with changes on this device not yet synced';
        return '\u25CF Synced to your account';
    }

    function buildRow(song: LocalSong): DocumentFragment {
        const fragment = document.importNode(rowTemplate.content, true);
        const item = find<HTMLLIElement>(fragment, 'li');
        const bars = song.sections.reduce((total, section) => total + section.bars, 0);

        item.dataset.id = song.id;
        find<HTMLElement>(item, '[data-field="title"]').textContent = song.title;
        find<HTMLElement>(item, '[data-field="meta"]').textContent = `${song.key}, ${song.tempo} BPM, ${bars} ${bars === 1 ? 'bar' : 'bars'}`;
        find<HTMLElement>(item, '[data-field="sync"]').textContent = syncLabel(song);

        for (const button of item.querySelectorAll<HTMLButtonElement>('[data-action]')) {
            const action = button.dataset.action;
            const labels: Record<string, string> = { edit: 'Edit', sync: song.syncedAt ? 'Sync changes' : 'Sync to account', unsync: 'Remove synced copy', export: 'Export', delete: 'Delete' };

            button.textContent = labels[action ?? ''] ?? button.textContent;
            button.setAttribute('aria-label', `${button.textContent} ${song.title}`);
            if (action === 'sync') button.hidden = !signedIn || (song.syncedAt !== null && !hasUnsyncedChanges(song));
            if (action === 'unsync') button.hidden = !signedIn || song.syncedAt === null;
        }

        return fragment;
    }

    function render(): void {
        const songs = getLocalSongs();

        empty.hidden = songs.length > 0;
        list.replaceChildren(...songs.map(buildRow));
    }

    async function request(method: 'PUT' | 'DELETE', url: string, body?: LocalSong): Promise<string | null> {
        try {
            const response = await fetch(url, {
                method,
                headers: body ? { 'Content-Type': 'application/json' } : undefined,
                body: body ? JSON.stringify(body) : undefined,
            });

            if (response.ok) return null;
            return response.status === 401 ? 'Sign in to sync songs.' : 'The server could not save this change. Your song on this device is unchanged.';
        } catch {
            return 'Could not reach the server. Your song on this device is unchanged.';
        }
    }

    function openDialog(song: LocalSong | null): void {
        form.reset();
        formError.textContent = '';
        dialogTitle.textContent = song ? 'Edit song' : 'New song';
        find<HTMLInputElement>(form, '[name="id"]').value = song?.id ?? '';

        if (song) {
            find<HTMLInputElement>(form, '[name="title"]').value = song.title;
            find<HTMLInputElement>(form, '[name="key"]').value = song.key;
            find<HTMLInputElement>(form, '[name="tempo"]').value = song.tempo.toString();
            find<HTMLInputElement>(form, '[name="melodyShared"]').checked = song.melodyShared;
        }

        dialog.showModal();
        find<HTMLInputElement>(form, '[name="title"]').focus();
    }

    function saveForm(): void {
        const data = new FormData(form);
        const parsed = songFormSchema.safeParse({ title: data.get('title'), key: data.get('key'), tempo: parseInt(data.get('tempo')?.toString() ?? '', 10), melodyShared: data.has('melodyShared') });

        if (!parsed.success) {
            formError.textContent = parsed.error.issues[0]?.message ?? 'Check the song details.';
            return;
        }

        const id = data.get('id');

        try {
            if (typeof id === 'string' && id) updateLocalSong(id, parsed.data);
            else createLocalSong(parsed.data);
        } catch {
            formError.textContent = 'This device has no room left to store the song. Export or delete a song and try again.';
            return;
        }

        dialog.close();
        render();
        say(`Saved "${parsed.data.title}" on this device.`);
    }

    async function syncSong(song: LocalSong): Promise<void> {
        const problem = await request('PUT', '/api/songs', song);

        if (problem) return fail(problem);
        markLocalSongSynced(song.id, new Date().toISOString());
        render();
        say(`Synced "${song.title}" to your account.`);
    }

    async function unsyncSong(song: LocalSong): Promise<void> {
        if (!window.confirm(`Remove the synced copy of "${song.title}"? The copy on this device stays.`)) return;
        const problem = await request('DELETE', `/api/songs?id=${encodeURIComponent(song.id)}`);

        if (problem) return fail(problem);
        markLocalSongSynced(song.id, null);
        render();
        say(`Removed the synced copy of "${song.title}". It is now on this device only.`);
    }

    async function removeSong(song: LocalSong): Promise<void> {
        const warning = song.syncedAt ? ' The synced copy in your account is deleted too.' : '';
        if (!window.confirm(`Delete "${song.title}"?${warning} This cannot be undone.`)) return;

        if (song.syncedAt) {
            const problem = await request('DELETE', `/api/songs?id=${encodeURIComponent(song.id)}`);
            if (problem) return fail(problem);
        }

        deleteLocalSong(song.id);
        render();
        say(`Deleted "${song.title}".`);
    }

    function exportSongs(songs: LocalSong[]): void {
        if (songs.length === 0) return fail('There are no songs to export.');
        downloadSongExport(songs, exportMelody.checked);
        say(`Exported ${songs.length} ${songs.length === 1 ? 'song' : 'songs'} ${exportMelody.checked ? 'with melodies' : 'without melodies'}.`);
    }

    root.addEventListener('click', event => {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-action]') : null;
        if (!button) return;

        const action = button.dataset.action;
        const song = getLocalSong(button.closest<HTMLElement>('[data-id]')?.dataset.id ?? '');

        if (action === 'create') openDialog(null);
        else if (action === 'export-all') exportSongs(getLocalSongs());
        else if (!song) return;
        else if (action === 'edit') openDialog(song);
        else if (action === 'sync') void syncSong(song);
        else if (action === 'unsync') void unsyncSong(song);
        else if (action === 'export') exportSongs([song]);
        else if (action === 'delete') void removeSong(song);
    });

    form.addEventListener('submit', event => {
        event.preventDefault();
        saveForm();
    });

    find<HTMLButtonElement>(dialog, '[data-action="cancel"]').addEventListener('click', () => dialog.close());

    root.querySelector<HTMLFormElement>('[data-role="delete-account"]')?.addEventListener('submit', async event => {
        event.preventDefault();
        if (!window.confirm('Delete your account? Every synced song is removed. Songs on this device stay.')) return;

        const password = new FormData(event.currentTarget instanceof HTMLFormElement ? event.currentTarget : undefined).get('password');
        const { error } = await authClient.deleteUser(typeof password === 'string' && password ? { password } : {});

        if (error) return fail(error.message ?? 'Could not delete the account.');
        window.location.assign('/');
    });

    render();
</script>
