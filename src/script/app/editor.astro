<script>
interface NoteMembership {
    pitch: string;
    inScale: boolean;
    inChord: boolean;
    symbol: string;
    reason: string;
}

interface EditorState {
    // Map from "bar:beat:pitch" to true for active notes.
    notes: Record<string, boolean>;
    membership: Record<string, NoteMembership>;
}

const PITCHES = ['C5','B4','A#4','A4','G#4','G4','F#4','F4','E4','D#4','D4','C#4','C4','B3','A#3','A3','G#3','G3','F#3','F3','E3','D3','C3'];
const DISPLAY_PITCHES = ['C5','B4','A4','G4','F4','E4','D4','C4','B3','A3','G3','F3','E3','D3','C3'];
const BEATS_PER_BAR = 4;

const keySelect    = document.getElementById('editor-key') as HTMLSelectElement;
const chordInput   = document.getElementById('editor-chord') as HTMLInputElement;
const barsInput    = document.getElementById('editor-bars') as HTMLInputElement;
const noteGrid     = document.getElementById('note-grid') as HTMLDivElement;
const notePanel    = document.getElementById('note-panel') as HTMLElement;
const noteDetail   = document.getElementById('note-detail') as HTMLDivElement;
const saveBtn      = document.getElementById('editor-save-btn') as HTMLButtonElement;
const clearBtn     = document.getElementById('editor-clear-btn') as HTMLButtonElement;
const saveStatus   = document.getElementById('editor-save-status') as HTMLSpanElement;

const state: EditorState = { notes: {}, membership: {} };

function escHtml(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function pitchWithoutOctave(pitch: string): string {
    return pitch.replace(/\d$/, '');
}

function buildGrid() {
    const bars = Math.min(parseInt(barsInput.value, 10) || 4, 16);
    const totalCols = bars * BEATS_PER_BAR;

    // Grid: pitch labels column + beat columns. We use a CSS grid with auto rows.
    const grid = document.createElement('div');
    grid.className = 'editor-page__grid';
    grid.style.gridTemplateColumns = `40px repeat(${totalCols}, 44px)`;
    grid.setAttribute('role', 'grid');

    // Header row — bar numbers.
    const corner = document.createElement('div');
    corner.className = 'editor-page__pitch-label editor-page__bar-header';
    grid.appendChild(corner);

    for (let b = 0; b < bars; b++) {
        const barHead = document.createElement('div');
        barHead.className = 'editor-page__bar-header';
        barHead.textContent = `Bar ${b + 1}`;
        barHead.style.gridColumn = `span ${BEATS_PER_BAR}`;
        grid.appendChild(barHead);
    }

    // Beat header row.
    const corner2 = document.createElement('div');
    corner2.className = 'editor-page__pitch-label editor-page__beat-header';
    grid.appendChild(corner2);

    for (let b = 0; b < bars; b++) {
        for (let beat = 1; beat <= BEATS_PER_BAR; beat++) {
            const beatHead = document.createElement('div');
            beatHead.className = 'editor-page__beat-header';
            beatHead.textContent = String(beat);
            grid.appendChild(beatHead);
        }
    }

    // Note rows.
    for (const pitch of DISPLAY_PITCHES) {
        const pitchBase = pitchWithoutOctave(pitch);
        const pitchLabel = document.createElement('div');
        pitchLabel.className = 'editor-page__pitch-label';
        pitchLabel.setAttribute('aria-hidden', 'true');
        pitchLabel.textContent = pitch;
        grid.appendChild(pitchLabel);

        for (let b = 0; b < bars; b++) {
            for (let beat = 1; beat <= BEATS_PER_BAR; beat++) {
                const key = `${b + 1}:${beat}:${pitch}`;
                const m = state.membership[pitchBase];
                const active = !!state.notes[key];

                const cell = document.createElement('button');
                cell.className = ['editor-page__cell',
                    active && m?.inScale === false ? 'editor-page__cell--out-of-scale' :
                    active ? 'editor-page__cell--active' : '',
                    active && m?.inChord ? 'editor-page__cell--chord-tone' : '',
                ].filter(Boolean).join(' ');
                cell.setAttribute('role', 'gridcell');
                cell.setAttribute('type', 'button');
                cell.setAttribute('aria-label', `${pitch}, bar ${b + 1}, beat ${beat}${active ? ', active' : ''}${active && m ? ', ' + (m.inScale ? 'in scale' : 'outside scale') : ''}`);
                cell.setAttribute('aria-pressed', String(active));
                cell.dataset.key = key;
                cell.dataset.pitch = pitch;
                cell.dataset.pitchBase = pitchBase;

                if (active && m) {
                    const sym = document.createElement('span');
                    sym.className = 'editor-page__cell-symbol';
                    sym.setAttribute('aria-hidden', 'true');
                    sym.textContent = m.symbol;
                    cell.appendChild(sym);
                }

                cell.addEventListener('click', () => toggleNote(key, pitch, cell));
                cell.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggleNote(key, pitch, cell); } });

                grid.appendChild(cell);
            }
        }
    }

    noteGrid.innerHTML = '';
    noteGrid.appendChild(grid);
}

function toggleNote(key: string, pitch: string, cell: HTMLButtonElement) {
    const pitchBase = pitchWithoutOctave(pitch);
    if (state.notes[key]) {
        delete state.notes[key];
        cell.setAttribute('aria-pressed', 'false');
        cell.className = 'editor-page__cell';
        cell.querySelector('.editor-page__cell-symbol')?.remove();
        showNoteDetail(null, null);
    } else {
        state.notes[key] = true;
        const m = state.membership[pitchBase];
        cell.setAttribute('aria-pressed', 'true');
        const classes = ['editor-page__cell'];
        if (m) {
            if (!m.inScale) classes.push('editor-page__cell--out-of-scale');
            else classes.push('editor-page__cell--active');
            if (m.inChord) classes.push('editor-page__cell--chord-tone');
        } else {
            classes.push('editor-page__cell--active');
        }
        cell.className = classes.join(' ');
        if (m) {
            const sym = document.createElement('span');
            sym.className = 'editor-page__cell-symbol';
            sym.setAttribute('aria-hidden', 'true');
            sym.textContent = m.symbol;
            cell.appendChild(sym);
        }
        showNoteDetail(pitch, m ?? null);
    }
    saveLocal();
    analyzeNotes();
}

function showNoteDetail(pitch: string | null, m: NoteMembership | null) {
    if (!pitch || !m) { notePanel.hidden = true; return; }
    notePanel.hidden = false;
    noteDetail.innerHTML = `
        <p><strong>${escHtml(pitch)}</strong> — ${m.inScale ? '<span class="note-in">✓ in scale</span>' : '<span class="note-out">! outside scale</span>'}${m.inChord ? ', chord tone' : ''}</p>
        <p>${escHtml(m.reason)}</p>
    `;
}

async function analyzeNotes() {
    const chord = chordInput.value.trim();
    if (!chord) return;
    const activeNotes = Object.keys(state.notes).map(k => k.split(':')[2]).filter(Boolean);
    const unique = [...new Set(activeNotes.map(p => p.replace(/\d$/, '')))];
    if (unique.length === 0) return;

    try {
        const res = await fetch('/api/modules/editor', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key: keySelect.value, chord, notes: unique }),
        });
        if (!res.ok) return;
        const data = await res.json() as { notes: NoteMembership[] };
        state.membership = {};
        for (const n of data.notes) state.membership[n.pitch] = n;
        buildGrid();
    } catch {}
}

function saveLocal() {
    localStorage.setItem('mc_editor_notes', JSON.stringify(state.notes));
    localStorage.setItem('mc_editor_key', keySelect.value);
    localStorage.setItem('mc_editor_chord', chordInput.value);
    localStorage.setItem('mc_editor_bars', barsInput.value);
}

function loadLocal() {
    const notes = localStorage.getItem('mc_editor_notes');
    const key   = localStorage.getItem('mc_editor_key');
    const chord = localStorage.getItem('mc_editor_chord');
    const bars  = localStorage.getItem('mc_editor_bars');
    if (notes) { try { Object.assign(state.notes, JSON.parse(notes) as Record<string, boolean>); } catch {} }
    if (key)   keySelect.value = key;
    if (chord) chordInput.value = chord;
    if (bars)  barsInput.value = bars;
}

keySelect.addEventListener('change', () => { saveLocal(); analyzeNotes(); });
chordInput.addEventListener('change', () => { saveLocal(); analyzeNotes(); });
barsInput.addEventListener('change', () => { saveLocal(); buildGrid(); analyzeNotes(); });

saveBtn.addEventListener('click', async () => {
    const songId = new URLSearchParams(window.location.search).get('song');
    if (!songId) { saveStatus.textContent = 'Open this editor from a song to save.'; return; }
    const notes = Object.entries(state.notes)
        .filter(([, v]) => v)
        .map(([key]) => {
            const [bar, beat, pitch] = key.split(':');
            return { bar: parseInt(bar, 10), beat: parseInt(beat, 10), duration: 1, pitch, string: null, fret: null };
        });
    const res = await fetch(`/api/modules/songs?id=${encodeURIComponent(songId)}`);
    if (!res.ok) { saveStatus.textContent = 'Could not load song.'; return; }
    const song = await res.json() as { sections: { id: string }[] };
    const sectionId = song.sections[0]?.id ?? 'default';
    await fetch('/api/modules/songs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: songId, sections: [{ id: sectionId, name: 'Section 1', bars: parseInt(barsInput.value, 10) || 4, chords: [], notes }] }),
    });
    saveStatus.textContent = 'Notes saved.';
    setTimeout(() => { saveStatus.textContent = ''; }, 3000);
});

clearBtn.addEventListener('click', () => {
    Object.keys(state.notes).forEach(k => { delete state.notes[k]; });
    state.membership = {};
    saveLocal();
    buildGrid();
    notePanel.hidden = true;
});

loadLocal();
buildGrid();
if (chordInput.value) analyzeNotes();
</script>
