---
import { siteConfig } from '@/lib/config';

import '@/styles/components/app/header.scss';

const currentPath = Astro.url.pathname;

const navLinks = [
    { href: '/app', label: 'Songs' },
    { href: '/app/progression', label: 'Progression' },
    { href: '/app/scales', label: 'Scales' },
    { href: '/app/editor', label: 'Editor' },
    { href: '/app/autofill', label: 'Autofill' },
];
---

<header class="app-header">
    <a class="app-header__skip-link" href="#main">Skip to content</a>
    <div class="container app-header__inner">
        <a class="app-header__brand" href="/app" aria-label={`${siteConfig.appName} home`}>
            <span class="app-header__badge" aria-hidden="true">&#x1D11E;</span>
            <span class="app-header__name">{siteConfig.appName}</span>
        </a>
        <nav class="app-header__nav" aria-label="App navigation">
            <ul class="app-header__nav-list" role="list">
                {navLinks.map(link => (
                    <li>
                        <a class="app-header__nav-link" href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>
