<script>
    import { nanoid } from 'nanoid';
    import { z } from 'zod';
    import { songInputSchema } from '@/db/validations';
    import { authClient } from '@/lib/auth/client';
    import songsConfig from '@/lib/songs.config';
    import { getChordTones, getMidi } from '@/lib/theory';

    const songFormSchema = songInputSchema.pick({ title: true, key: true, tempo: true });
    const localSongsSchema = z.array(songInputSchema.extend({ syncedAt: z.string().max(40).nullable() }));
    const remoteSongsSchema = z.object({ data: z.array(songInputSchema) });

    type LocalSong = z.infer<typeof localSongsSchema>[number];

    function getLocalSongs(): LocalSong[] {
        const raw = localStorage.getItem(songsConfig.storageKey);
        if (!raw) return [];

        try {
            const parsed = localSongsSchema.safeParse(JSON.parse(raw));
            if (parsed.success) return parsed.data.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
        } catch {
            // Fall through to the backup below, the stored text is not valid JSON
        }

        localStorage.setItem(songsConfig.backupKey, raw);
        return [];
    }

    function createLocalSong(form: z.infer<typeof songFormSchema>): LocalSong {
        const now = new Date().toISOString();
        const song: LocalSong = {
            id: nanoid(),
            ...form,
            sampleProgressionId: null,
            sections: [],
            suggestions: [],
            createdAt: now,
            updatedAt: now,
            syncedAt: null,
        };

        localStorage.setItem(songsConfig.storageKey, JSON.stringify([...getLocalSongs(), song]));
        return song;
    }

    function updateLocalSong(id: string, form: z.infer<typeof songFormSchema>): LocalSong | null {
        const songs = getLocalSongs();
        const index = songs.findIndex(song => song.id === id);
        if (index === -1) return null;

        const song: LocalSong = { ...songs[index], ...form, updatedAt: new Date().toISOString() };
        songs[index] = song;
        localStorage.setItem(songsConfig.storageKey, JSON.stringify(songs));
        return song;
    }

    function markLocalSongSynced(id: string, syncedAt: string | null): LocalSong | null {
        const songs = getLocalSongs();
        const index = songs.findIndex(song => song.id === id);
        if (index === -1) return null;

        const song: LocalSong = { ...songs[index], syncedAt };
        songs[index] = song;
        localStorage.setItem(songsConfig.storageKey, JSON.stringify(songs));
        return song;
    }

    function deleteLocalSong(id: string): void {
        localStorage.setItem(songsConfig.storageKey, JSON.stringify(getLocalSongs().filter(song => song.id !== id)));
    }

    function hasUnsyncedChanges(song: LocalSong): boolean {
        return song.syncedAt !== null && song.updatedAt > song.syncedAt;
    }

    function downloadSongExport(songs: LocalSong[], includeMelody: boolean): void {
        const songExport = {
            format: 'tonepilot-songs',
            version: 1,
            exportedAt: new Date().toISOString(),
            includesMelody: includeMelody,
            songs: songs.map(song => ({
                title: song.title,
                key: song.key,
                tempo: song.tempo,
                sections: song.sections.map(({ notes, ...section }) => (includeMelody ? { ...section, notes } : section)),
            })),
        };
        const url = URL.createObjectURL(new Blob([JSON.stringify(songExport, null, 4)], { type: 'application/json' }));
        const link = document.createElement('a');

        link.href = url;
        link.download = `tonepilot-songs-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.append(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
    }

    const list = document.querySelector('[data-role="list"]');
    const empty = document.querySelector('[data-role="empty"]');
    const status = document.querySelector('[data-role="status"]');
    const errorMessage = document.querySelector('[data-role="error"]');
    const exportMelody = document.querySelector('[data-role="export-melody"]');
    const dialog = document.querySelector('[data-role="dialog"]');
    const form = document.querySelector('[data-role="song-form"]');
    const formError = document.querySelector('[data-role="form-error"]');
    const dialogTitle = document.querySelector('[data-role="dialog-title"]');
    const rowTemplate = document.querySelector('#song-row');

    function syncLabel(song: LocalSong): string {
        if (!song.syncedAt) return '\u25CB On this device only';
        if (hasUnsyncedChanges(song)) return '\u25D0 Synced to your account, with changes on this device not yet synced';
        return '\u25CF Synced to your account';
    }

    function buildRow(song: LocalSong): DocumentFragment {
        const fragment = rowTemplate instanceof HTMLTemplateElement ? document.importNode(rowTemplate.content, true) : new DocumentFragment();
        const item = fragment.querySelector('li');
        const bars = song.sections.reduce((total, section) => total + section.bars, 0);

        if (!item) return fragment;

        item.dataset.id = song.id;
        const title = item.querySelector('[data-field="title"]');
        const meta = item.querySelector('[data-field="meta"]');
        const sync = item.querySelector('[data-field="sync"]');
        if (title) title.textContent = song.title;
        if (meta) meta.textContent = `${song.key}, ${song.tempo} BPM, ${bars} ${bars === 1 ? 'bar' : 'bars'}`;
        if (sync) sync.textContent = syncLabel(song);

        const editButton = item.querySelector('.songs__edit');
        editButton?.setAttribute('aria-label', `Edit ${song.title}`);
        editButton?.addEventListener('click', () => openDialog(song));

        const syncButton = item.querySelector('.songs__sync-button');
        const syncLabelText = song.syncedAt ? 'Sync changes' : 'Sync to account';
        if (syncButton) syncButton.textContent = syncLabelText;
        syncButton?.setAttribute('aria-label', `${syncLabelText} ${song.title}`);
        if (syncButton instanceof HTMLElement) syncButton.hidden = song.syncedAt !== null && !hasUnsyncedChanges(song);
        syncButton?.addEventListener('click', () => void syncSong(song));

        const unsyncButton = item.querySelector('.songs__unsync');
        unsyncButton?.setAttribute('aria-label', `Remove synced copy of ${song.title}`);
        if (unsyncButton instanceof HTMLElement) unsyncButton.hidden = song.syncedAt === null;
        unsyncButton?.addEventListener('click', () => void unsyncSong(song));

        const exportButton = item.querySelector('.songs__export');
        exportButton?.setAttribute('aria-label', `Export ${song.title}`);
        exportButton?.addEventListener('click', () => exportSongs([song]));

        const playButton = item.querySelector('.songs__play');
        if (playButton) playButton.textContent = playingId === song.id ? 'Stop' : 'Play';
        playButton?.setAttribute('aria-label', `${playingId === song.id ? 'Stop' : 'Play'} ${song.title}`);
        playButton?.addEventListener('click', () => void playSong(song));

        const deleteButton = item.querySelector('.songs__delete');
        deleteButton?.setAttribute('aria-label', `Delete ${song.title}`);
        deleteButton?.addEventListener('click', () => void removeSong(song));

        for (const link of item.querySelectorAll('a[data-link]')) {
            if (!(link instanceof HTMLAnchorElement)) continue;

            link.href = `/app/${link.dataset.link}?song=${encodeURIComponent(song.id)}`;
            link.setAttribute('aria-label', `${link.textContent} for ${song.title}`);
            link.hidden = song.syncedAt === null;
        }

        return fragment;
    }

    function render(): void {
        const songs = getLocalSongs();

        if (empty instanceof HTMLElement) empty.hidden = songs.length > 0;
        if (!list) return;
        list.textContent = '';
        list.append(...songs.map(buildRow));
    }

    async function request(method: 'PUT' | 'DELETE', url: string, body?: LocalSong): Promise<string | null> {
        try {
            const response = await fetch(url, {
                method,
                headers: body ? { 'Content-Type': 'application/json' } : undefined,
                body: body ? JSON.stringify(body) : undefined,
            });

            if (response.ok) return null;
            return 'The server could not save this change. Your song on this device is unchanged.';
        } catch {
            return 'Could not reach the server. Your song on this device is unchanged.';
        }
    }

    function openDialog(song: LocalSong | null): void {
        const idInput = document.getElementById('song-id');
        const titleInput = document.getElementById('song-title');
        const keyInput = document.getElementById('song-key');
        const tempoInput = document.getElementById('song-tempo');

        if (form instanceof HTMLFormElement) form.reset();
        if (formError) formError.textContent = '';
        if (dialogTitle) dialogTitle.textContent = song ? 'Edit song' : 'New song';
        if (idInput instanceof HTMLInputElement) idInput.value = song?.id ?? '';

        if (song && titleInput instanceof HTMLInputElement) titleInput.value = song.title;
        if (song && keyInput instanceof HTMLInputElement) keyInput.value = song.key;
        if (song && tempoInput instanceof HTMLInputElement) tempoInput.value = song.tempo.toString();

        if (dialog instanceof HTMLDialogElement) dialog.showModal();
        titleInput?.focus();
    }

    function saveForm(): void {
        if (!(form instanceof HTMLFormElement)) return;

        const data = new FormData(form);
        const parsed = songFormSchema.safeParse({ title: data.get('title'), key: data.get('key'), tempo: parseInt(data.get('tempo')?.toString() ?? '', 10) });

        if (!parsed.success) {
            if (formError) formError.textContent = parsed.error.issues[0]?.message ?? 'Check the song details.';
            return;
        }

        const id = data.get('id');
        let song: LocalSong | null | undefined;

        try {
            if (typeof id === 'string' && id) song = updateLocalSong(id, parsed.data);
            else song = createLocalSong(parsed.data);
        } catch {
            if (formError) formError.textContent = 'This device has no room left to store the song. Export or delete a song and try again.';
            return;
        }

        if (dialog instanceof HTMLDialogElement) dialog.close();
        render();
        if (errorMessage) errorMessage.textContent = '';
        if (status) status.textContent = `Saved "${parsed.data.title}" on this device.`;
        const editButton = list?.querySelector('li:first-child .songs__edit');
        if (editButton instanceof HTMLElement) editButton.focus();
        if (song) void syncSong(song, false);
    }

    async function syncSong(song: LocalSong, moveFocus = true): Promise<void> {
        const problem = await request('PUT', '/api/songs', song);

        if (problem) {
            if (status) status.textContent = '';
            if (errorMessage) errorMessage.textContent = problem;
            return;
        }

        markLocalSongSynced(song.id, new Date().toISOString());
        render();
        if (errorMessage) errorMessage.textContent = '';
        if (status) status.textContent = `Synced "${song.title}" to your account.`;
        const unsyncButton = list?.querySelector(`[data-id="${CSS.escape(song.id)}"] .songs__unsync`);
        if (moveFocus && unsyncButton instanceof HTMLElement) unsyncButton.focus();
    }

    async function unsyncSong(song: LocalSong): Promise<void> {
        if (!window.confirm(`Remove the synced copy of "${song.title}"? The copy on this device stays.`)) return;
        const problem = await request('DELETE', `/api/songs?id=${encodeURIComponent(song.id)}`);

        if (problem) {
            if (status) status.textContent = '';
            if (errorMessage) errorMessage.textContent = problem;
            return;
        }

        markLocalSongSynced(song.id, null);
        render();
        if (errorMessage) errorMessage.textContent = '';
        if (status) status.textContent = `Removed the synced copy of "${song.title}". It is now on this device only.`;
        const syncButton = list?.querySelector(`[data-id="${CSS.escape(song.id)}"] .songs__sync-button`);
        if (syncButton instanceof HTMLElement) syncButton.focus();
    }

    async function removeSong(song: LocalSong): Promise<void> {
        const warning = song.syncedAt ? ' The synced copy in your account is deleted too.' : '';
        if (!window.confirm(`Delete "${song.title}"?${warning} This cannot be undone.`)) return;

        if (song.syncedAt) {
            const problem = await request('DELETE', `/api/songs?id=${encodeURIComponent(song.id)}`);

            if (problem) {
                if (status) status.textContent = '';
                if (errorMessage) errorMessage.textContent = problem;
                return;
            }
        }

        deleteLocalSong(song.id);
        render();
        if (errorMessage) errorMessage.textContent = '';
        if (status) status.textContent = `Deleted "${song.title}".`;
        document.getElementById('songs-title')?.focus();
    }

    function exportSongs(songs: LocalSong[]): void {
        if (songs.length === 0) {
            if (status) status.textContent = '';
            if (errorMessage) errorMessage.textContent = 'There are no songs to export.';
            return;
        }

        const includeMelody = exportMelody instanceof HTMLInputElement && exportMelody.checked;
        downloadSongExport(songs, includeMelody);
        if (errorMessage) errorMessage.textContent = '';
        if (status) status.textContent = `Exported ${songs.length} ${songs.length === 1 ? 'song' : 'songs'} ${includeMelody ? 'with melodies' : 'without melodies'}.`;
    }

    let audio: AudioContext | null = null;
    let playingId: string | null = null;

    function playTone(context: AudioContext, midi: number, start: number, length: number, type: OscillatorType, volume: number): void {
        const oscillator = context.createOscillator();
        const gain = context.createGain();

        oscillator.type = type;
        oscillator.frequency.value = 440 * 2 ** ((midi - 69) / 12);
        gain.gain.setValueAtTime(0, start);
        gain.gain.linearRampToValueAtTime(volume, start + 0.02);
        gain.gain.linearRampToValueAtTime(0, start + length);
        oscillator.connect(gain).connect(context.destination);
        oscillator.start(start);
        oscillator.stop(start + length + 0.05);
    }

    function stopPlayback(): void {
        void audio?.close();
        audio = null;
        playingId = null;
        render();
    }

    async function playSong(song: LocalSong): Promise<void> {
        const wasPlaying = playingId === song.id;
        if (audio) stopPlayback();
        if (wasPlaying) return;

        let sections = song.sections;

        try {
            const parsed = remoteSongsSchema.safeParse(await (await fetch('/api/songs')).json());
            const remote = parsed.success ? parsed.data.data.find(candidate => candidate.id === song.id) : undefined;
            if (remote) sections = remote.sections;
        } catch {
            // The copy on this device is played when the account copy cannot be loaded
        }

        if (!sections.some(section => section.chords.length > 0 || section.notes.length > 0)) {
            if (status) status.textContent = '';
            if (errorMessage) errorMessage.textContent = `"${song.title}" has no chords or notes to play yet.`;
            return;
        }

        const context = new AudioContext();
        const beat = 60 / song.tempo;
        let offset = context.currentTime + 0.1;

        for (const section of sections) {
            const chords = [...section.chords].sort((a, b) => a.bar - b.bar || a.beat - b.beat);

            for (let index = 0; index < chords.length; index++) {
                const start = ((chords[index].bar - 1) * 4 + chords[index].beat - 1) * beat;
                const end = chords[index + 1] ? ((chords[index + 1].bar - 1) * 4 + chords[index + 1].beat - 1) * beat : section.bars * 4 * beat;

                for (const tone of getChordTones(chords[index].name)) playTone(context, 48 + tone, offset + start, end - start, 'triangle', 0.08);
            }

            for (const note of section.notes) {
                const midi = getMidi(note.pitch);
                if (midi > 0) playTone(context, midi, offset + ((note.bar - 1) * 4 + note.beat - 1) * beat, note.duration * beat, 'sine', 0.2);
            }

            offset += section.bars * 4 * beat;
        }

        audio = context;
        playingId = song.id;
        render();
        if (errorMessage) errorMessage.textContent = '';
        if (status) status.textContent = `Playing "${song.title}".`;
        window.setTimeout(() => {
            if (audio === context) stopPlayback();
        }, (offset - context.currentTime) * 1000 + 200);
    }

    document.getElementById('export-all')?.addEventListener('click', () => exportSongs(getLocalSongs()));

    document.getElementById('song-create')?.addEventListener('click', () => openDialog(null));

    form?.addEventListener('submit', event => {
        event.preventDefault();
        saveForm();
    });

    document.getElementById('song-cancel')?.addEventListener('click', () => {
        if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    document.querySelector('[data-role="delete-account"]')?.addEventListener('submit', async event => {
        event.preventDefault();
        if (!window.confirm('Delete your account? Every synced song is removed. Songs on this device stay.')) return;

        const password = new FormData(event.currentTarget instanceof HTMLFormElement ? event.currentTarget : undefined).get('password');
        const { error } = await authClient.deleteUser(typeof password === 'string' && password ? { password } : {});

        if (error) {
            if (status) status.textContent = '';
            if (errorMessage) errorMessage.textContent = error.message ?? 'Could not delete the account.';
            return;
        }

        window.location.assign('/');
    });

    async function pullAccountSongs(): Promise<void> {
        try {
            const parsed = remoteSongsSchema.safeParse(await (await fetch('/api/songs')).json());
            if (!parsed.success) return;

            const songs = getLocalSongs();
            const missing = parsed.data.data.filter(remote => !songs.some(local => local.id === remote.id));
            if (missing.length === 0) return;

            localStorage.setItem(songsConfig.storageKey, JSON.stringify([...songs, ...missing.map(remote => ({ ...remote, syncedAt: remote.updatedAt }))]));
            render();
        } catch {
            // Songs on this device stay listed when the account cannot be reached
        }
    }

    render();
    void pullAccountSongs();
</script>
